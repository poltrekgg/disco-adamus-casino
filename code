    void HandleRouletteInput(Vector2 mouse, ProceduralAudio& audio) {
        if (btnBackMenu.IsClicked(mouse) && !rouletteSpinning) {
            ClearRouletteBets(audio);
            PlaySound(audio.sndClick);
            isMegaWin = false;
            SaveGame();
            currentScreen = SCREEN_MENU;
            return;
        }

        if (btnChip10.IsClicked(mouse))  { selectedChipValue = 10;  PlaySound(audio.sndChip); }
        if (btnChip50.IsClicked(mouse))  { selectedChipValue = 50;  PlaySound(audio.sndChip); }
        if (btnChip100.IsClicked(mouse)) { selectedChipValue = 100; PlaySound(audio.sndChip); }
        if (btnChip500.IsClicked(mouse)) { selectedChipValue = 500; PlaySound(audio.sndChip); }

        if (!rouletteSpinning) {
            if (btnRouletteClear.IsClicked(mouse)) {
                ClearRouletteBets(audio);
            } else if (btnRouletteSpin.IsClicked(mouse) || IsKeyPressed(KEY_SPACE)) {
                StartRouletteSpin(audio);
            }

            // Obstawianie pól stołu LPM
            if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
                for (auto& spot : rouletteSpots) {
                    if (CheckCollisionPointRec(mouse, spot.rect)) {
                        int chip = std::min(selectedChipValue, balance);
                        if (chip > 0) {
                            balance -= chip;
                            spot.amount += chip;
                            PlaySound(audio.sndChip);
                            rouletteMsg = TextFormat("POSTAWIONO $%d NA [%s]  |  ŁĄCZNIE NA STOLE: $%d",
                                                     chip, spot.label.c_str(), GetTotalRouletteBet());
                            rouletteMsgCol = COL_CYAN;
                        } else {
                            rouletteMsg = "BRAK ŚRODKÓW NA KONCIE!";
                            rouletteMsgCol = COL_PINK;
                            PlaySound(audio.sndLose);
                        }
                        break;
                    }
                }
            }
        }
    }

    void DrawRouletteWheel(const FontSystem& fonts) const {
        Vector2 center = { 255.0f, 345.0f };
        float outerR = 195.0f;
        float pocketOuterR = 175.0f;
        float pocketInnerR = 102.0f;
        float sectorStep = 360.0f / 37.0f;

        // Zewnętrzna obręcz mahoniowo-złota z neonem
        DrawCircleV({ center.x + 5, center.y + 8 }, outerR + 6, { 0, 0, 0, 160 });
        DrawCircleV(center, outerR + 4, COL_GOLD);
        DrawCircleV(center, outerR, { 38, 12, 58, 255 });
        DrawCircleV(center, pocketOuterR + 4, COL_CYAN);

        // 37 wycinków koła europejskiego
        for (int i = 0; i < 37; i++) {
            int num = ROULETTE_WHEEL[i];
            float a1 = rouletteWheelAngle + i * sectorStep;
            float a2 = a1 + sectorStep;

            Color secCol = (num == 0) ? Color{ 0, 165, 80, 255 }
                         : (IsRedNumber(num) ? Color{ 205, 12, 65, 255 } : Color{ 20, 22, 36, 255 });

            DrawCircleSector(center, pocketOuterR, a1, a2, 12, secCol);
            DrawCircleSectorLines(center, pocketOuterR, a1, a2, 4, { 255, 215, 0, 110 });

            float midRad = (a1 + sectorStep * 0.5f) * DEG2RAD;
            Vector2 numPos = {
                center.x + cosf(midRad) * 148.0f,
                center.y + sinf(midRad) * 148.0f
            };
            fonts.DrawCentered(TextFormat("%d", num), numPos.x, numPos.y, 16.0f, WHITE, false);
        }

        // Środek koła (Złota głowica kasynowa)
        DrawCircleV(center, pocketInnerR, COL_GOLD);
        DrawCircleV(center, pocketInnerR - 5.0f, { 28, 0, 52, 255 });
        DrawCircleV(center, 36.0f, COL_GOLD);
        DrawCircleV(center, 28.0f, COL_PINK);
        fonts.DrawCentered("VIP", center.x, center.y, 20.0f, WHITE, false);

        // Kulka ruletki
        float ballRad = rouletteBallAngle * DEG2RAD;
        Vector2 ballPos = {
            center.x + cosf(ballRad) * rouletteBallRadius,
            center.y + sinf(ballRad) * rouletteBallRadius
        };
        DrawCircleV({ ballPos.x + 2, ballPos.y + 3 }, 8.5f, { 0, 0, 0, 170 });
        DrawCircleV(ballPos, 8.0f, WHITE);
        DrawCircleV({ ballPos.x - 2, ballPos.y - 2 }, 3.0f, COL_CYAN);
    }

