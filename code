            { RBET_ODD,   "NIEPARZ.",   { 30, 0, 56, 255 } },
            { RBET_HIGH,  "19-36",      { 30, 0, 56, 255 } }
        };
        for (int i = 0; i < 6; i++) {
            Rectangle r = {
                startX + i * evenW,
                evenY,
                evenW - 4.0f,
                52.0f
            };
            rouletteSpots.push_back({ r, evens[i].t, i, evens[i].lbl, evens[i].col, 0 });
        }
    }

