                fonts.DrawCentered(rank, drawX + w - 16.0f * scaleX, drawY + CARD_H - 36.0f, 22.0f * scaleX, suitCol, false);
                DrawSuitIcon(suit, drawX + w - 16.0f * scaleX, drawY + CARD_H - 16.0f, 8.5f, scaleX, suitCol);

                if (rank == "J" || rank == "Q" || rank == "K") {
                    DrawCircleV({ cx, cy }, 34.0f * scaleX, { 26, 0, 48, 255 });
                    DrawCircleV({ cx, cy }, 31.0f * scaleX, isRed ? Color{ 65, 0, 35, 255 } : Color{ 0, 40, 65, 255 });

                    Vector2 cBaseL = { cx - 18.0f * scaleX, cy - 4.0f };
                    Vector2 cBaseR = { cx + 18.0f * scaleX, cy - 4.0f };
                    DrawTriangle({ cx - 18.0f * scaleX, cy - 22.0f }, cBaseL, { cx + 2.0f * scaleX, cy - 4.0f }, COL_GOLD);
                    DrawTriangle({ cx, cy - 26.0f }, { cx - 12.0f * scaleX, cy - 4.0f }, { cx + 12.0f * scaleX, cy - 4.0f }, COL_GOLD);
                    DrawTriangle({ cx + 18.0f * scaleX, cy - 22.0f }, { cx - 2.0f * scaleX, cy - 4.0f }, cBaseR, COL_GOLD);

                    DrawRectangleRec({ cx - 18.0f * scaleX, cy + 1.0f, 15.0f * scaleX, 9.0f }, COL_CYAN);
                    DrawRectangleRec({ cx + 3.0f * scaleX, cy + 1.0f, 15.0f * scaleX, 9.0f }, COL_PINK);
                    DrawRectangleRec({ cx - 20.0f * scaleX, cy - 1.0f, 40.0f * scaleX, 3.0f }, COL_GOLD);

                    fonts.DrawCentered(rank, cx, cy + 22.0f, 22.0f * scaleX, COL_GOLD, false);
                } else if (rank == "A") {
                    float pulse = 1.0f + sinf(globalTime * 6.0f) * 0.08f;
                    DrawCircleV({ cx, cy }, 34.0f * scaleX * pulse, { 255, 215, 0, 55 });
                    DrawSuitIcon(suit, cx, cy, 26.0f * pulse, scaleX, suitCol);
                } else {
                    DrawSuitIcon(suit, cx, cy, 23.0f, scaleX, suitCol);
                }
            }
        }
    }
};

