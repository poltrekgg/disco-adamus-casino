bool IsRedNumber(int n) {
    if (n <= 0) return false;
    const int reds[] = { 1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36 };
    for (int r : reds) {
        if (r == n) return true;
    }
    return false;
}

