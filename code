    // ========================================================================
    // GŁÓWNA FUNKCJA RENDERUJĄCA
    // ========================================================================
    void Draw(const FontSystem& fonts, float time, ProceduralAudio& audio) {
        Vector2 mousePos = GetMousePosition();

        bool strobeFlash = false;
        if (isMegaWin && intenseStrobe && ((int)(megaWinTimer * 28.0f) % 2 == 0)) {
            strobeFlash = true;
            Color strobeCols[] = {
                { 180, 0, 60, 255 }, { 0, 160, 140, 255 }, { 90, 0, 180, 255 },
                { 180, 140, 0, 255 }, { 0, 90, 190, 255 }, COL_BG
            };
            ClearBackground(strobeCols[GetRandomValue(0, 5)]);
        } else {
            ClearBackground(COL_BG);
        }

        Camera2D cam = { 0 };
        cam.zoom = 1.0f;
        if (screenShake > 0.0f) {
            cam.offset.x = (float)GetRandomValue(-100, 100) / 100.0f * screenShake;
            cam.offset.y = (float)GetRandomValue(-100, 100) / 100.0f * screenShake;
        }

        BeginMode2D(cam);

        DrawDiscoLasers(time);

        if (currentScreen == SCREEN_MENU) {
            DrawMenuScreen(fonts, time, mousePos);
        } else if (currentScreen == SCREEN_BLACKJACK) {
            DrawBlackjackScreen(fonts, time, mousePos, strobeFlash);
        } else if (currentScreen == SCREEN_ROULETTE) {
            DrawRouletteScreen(fonts, time, mousePos);
        } else if (currentScreen == SCREEN_SHOP) {
            DrawAndHandleShopScreen(fonts, time, mousePos, audio);
        }

        DrawMegaWinOverlay(fonts);

        EndMode2D();
    }
