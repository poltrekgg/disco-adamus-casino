struct FontSystem {
    Font fontMain;
    bool hasPolishGlyphs = false;

    void Init() {
        std::vector<int> codepoints;
        for (int i = 32; i <= 126; i++) codepoints.push_back(i);
        int polishChars[] = {
            0x0104, 0x0105, 0x0106, 0x0107, 0x0118, 0x0119,
            0x0141, 0x0142, 0x0143, 0x0144, 0x00D3, 0x00F3,
            0x015A, 0x015B, 0x0179, 0x017A, 0x017B, 0x017C
        };
        for (int cp : polishChars) codepoints.push_back(cp);

        const char* fontPaths[] = {
            "/System/Library/Fonts/Supplemental/Impact.ttf",
            "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
            "/Library/Fonts/Arial Bold.ttf",
            "C:/Windows/Fonts/impact.ttf",
            "C:/Windows/Fonts/arialbd.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
        };

        hasPolishGlyphs = false;
        for (const char* path : fontPaths) {
            if (FileExists(path)) {
                fontMain = LoadFontEx(path, 96, codepoints.data(), (int)codepoints.size());
                SetTextureFilter(fontMain.texture, TEXTURE_FILTER_BILINEAR);
                hasPolishGlyphs = true;
                break;
            }
        }
        if (!hasPolishGlyphs) {
            fontMain = GetFontDefault();
        }
    }

    void Unload() {
        if (hasPolishGlyphs) UnloadFont(fontMain);
    }

    std::string SafeStr(const std::string& s) const {
        if (hasPolishGlyphs) return s;
        std::string out;
        for (size_t i = 0; i < s.size(); ++i) {
            unsigned char c = s[i];
            if (c == 0xC3 && i + 1 < s.size()) {
                unsigned char n = s[++i];
                if (n == 0x93) out += 'O';
                else if (n == 0xB3) out += 'o';
            } else if (c == 0xC4 && i + 1 < s.size()) {
                unsigned char n = s[++i];
                if (n == 0x84) out += 'A'; else if (n == 0x85) out += 'a';
                else if (n == 0x86) out += 'C'; else if (n == 0x87) out += 'c';
                else if (n == 0x98) out += 'E'; else if (n == 0x99) out += 'e';
            } else if (c == 0xC5 && i + 1 < s.size()) {
                unsigned char n = s[++i];
                if (n == 0x81) out += 'L'; else if (n == 0x82) out += 'l';
                else if (n == 0x83) out += 'N'; else if (n == 0x84) out += 'n';
                else if (n == 0x9A) out += 'S'; else if (n == 0x9B) out += 's';
                else if (n == 0xB9 || n == 0xBB) out += 'Z';
                else if (n == 0xBA || n == 0xBC) out += 'z';
            } else {
                out += s[i];
            }
        }
        return out;
    }

    void DrawCentered(const std::string& text, float cx, float cy, float size, Color col, bool shadow = true) const {
        std::string st = SafeStr(text);
        float spacing = size * 0.04f;
        Vector2 dim = MeasureTextEx(fontMain, st.c_str(), size, spacing);
        Vector2 pos = { cx - dim.x * 0.5f, cy - dim.y * 0.5f };
        if (shadow) {
            DrawTextEx(fontMain, st.c_str(), { pos.x + 2.0f, pos.y + 3.0f }, size, spacing, { 0, 0, 0, 190 });
        }
        DrawTextEx(fontMain, st.c_str(), pos, size, spacing, col);
    }
};

// ============================================================================
// PROCEDURALNY SYNTEZATOR DŹWIĘKU W PAMIĘCI RAM (ZERO PLIKÓW WAV)
// ============================================================================
struct ProceduralAudio {
    Sound sndCardDeal;
    Sound sndCardFlip;
    Sound sndChip;
    Sound sndWin;
    Sound sndMegaWin;
    Sound sndLose;
    Sound sndClick;
    Sound sndBassKick;
    Sound sndRouletteTick;

    Wave CreateBlankWave(int sampleCount, short** outData) {
        Wave w = { 0 };
        w.frameCount = sampleCount;
        w.sampleRate = 44100;
        w.sampleSize = 16;
        w.channels = 1;
        *outData = (short*)RL_MALLOC(sampleCount * sizeof(short));
        w.data = *outData;
        return w;
    }

    void Init() {
        InitAudioDevice();
        const int sr = 44100;

        // 1. Rozdanie karty
        {
            int n = (int)(sr * 0.14f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            float lp = 0.0f;
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float env = sinf((float)i / n * PI) * expf(-t * 14.0f);
                float noise = ((float)(GetRandomValue(-1000, 1000)) / 1000.0f);
                lp = lp * 0.72f + noise * 0.28f;
                float tone = sinf(2.0f * PI * (380.0f - t * 1800.0f) * t) * 0.35f;
                d[i] = (short)(std::clamp((lp + tone) * env, -1.0f, 1.0f) * 20000);
            }
            sndCardDeal = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 2. Obrót karty 3D
        {
            int n = (int)(sr * 0.11f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float env = expf(-t * 32.0f);
                float freq = 260.0f + 520.0f * (t * 8.0f);
                float sig = sinf(2.0f * PI * freq * t) * 0.7f;
                d[i] = (short)(std::clamp(sig * env, -1.0f, 1.0f) * 22000);
            }
            sndCardFlip = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 3. Żeton kasynowy
        {
            int n = (int)(sr * 0.12f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float env = expf(-t * 35.0f);
                float s1 = sinf(2.0f * PI * 2150.0f * t);
                float s2 = sinf(2.0f * PI * 3890.0f * t) * 0.6f;
                float s3 = sinf(2.0f * PI * 5420.0f * t) * 0.3f;
                d[i] = (short)(std::clamp((s1 + s2 + s3) * 0.45f * env, -1.0f, 1.0f) * 21000);
            }
            sndChip = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 4. Wygrana
        {
            int n = (int)(sr * 0.65f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            float notes[] = { 523.25f, 659.25f, 783.99f, 1046.50f };
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                int idx = std::min(3, (int)(t / 0.13f));
                float localT = t - idx * 0.13f;
                float env = expf(-localT * 6.5f);
                float f = notes[idx];
                float sig = sinf(2.0f * PI * f * t) * 0.6f
                          + sinf(2.0f * PI * f * 2.0f * t) * 0.25f
                          + (sinf(2.0f * PI * f * 0.5f * t) > 0 ? 0.15f : -0.15f);
                d[i] = (short)(std::clamp(sig * env, -1.0f, 1.0f) * 22000);
            }
            sndWin = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 5. MEGA WIN
        {
            int n = (int)(sr * 1.45f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            float arp[] = { 523.25f, 659.25f, 783.99f, 1046.5f, 1318.5f, 1567.98f, 2093.0f };
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float bassFreq = 130.0f * expf(-t * 2.2f) + 38.0f;
                float bass = sinf(2.0f * PI * bassFreq * t) * expf(-t * 1.8f) * 0.65f;
                int aIdx = ((int)(t * 16.0f)) % 7;
                float f = arp[aIdx];
                float leadEnv = expf(-fmodf(t, 0.0625f) * 14.0f) * (1.0f - t / 1.55f);
                float lead = (sinf(2.0f * PI * f * t) + 0.4f * sinf(2.0f * PI * f * 2.0f * t)) * leadEnv * 0.45f;
                d[i] = (short)(std::clamp(bass + lead, -1.0f, 1.0f) * 26000);
            }
            sndMegaWin = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 6. Przegrana
        {
            int n = (int)(sr * 0.55f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float env = expf(-t * 3.5f);
                float f = 240.0f - t * 170.0f + sinf(t * 35.0f) * 8.0f;
                float saw = 2.0f * (t * f - floorf(0.5f + t * f));
                float sig = sinf(2.0f * PI * f * t) * 0.6f + saw * 0.3f;
                d[i] = (short)(std::clamp(sig * env, -1.0f, 1.0f) * 18000);
            }
            sndLose = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 7. Klik przycisku
        {
            int n = (int)(sr * 0.04f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float sig = sinf(2.0f * PI * 950.0f * t) * expf(-t * 80.0f);
                d[i] = (short)(sig * 16000);
            }
            sndClick = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 8. Dyskotekowy Bass Kick
        {
            int n = (int)(sr * 0.18f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float freq = 150.0f * expf(-t * 28.0f) + 45.0f;
                float env = expf(-t * 14.0f);
                float sig = sinf(2.0f * PI * freq * t) * env;
                d[i] = (short)(std::clamp(sig * 1.3f, -1.0f, 1.0f) * 24000);
            }
            sndBassKick = LoadSoundFromWave(w);
            UnloadWave(w);
        }

        // 9. Stukot kulki ruletki o przegrody
        {
            int n = (int)(sr * 0.028f);
            short* d = nullptr;
            Wave w = CreateBlankWave(n, &d);
            for (int i = 0; i < n; i++) {
                float t = (float)i / sr;
                float env = expf(-t * 130.0f);
                float sig = (sinf(2.0f * PI * 1650.0f * t) * 0.7f + sinf(2.0f * PI * 3100.0f * t) * 0.3f) * env;
                d[i] = (short)(std::clamp(sig, -1.0f, 1.0f) * 17000);
            }
            sndRouletteTick = LoadSoundFromWave(w);
            UnloadWave(w);
        }
    }

    void Unload() {
        UnloadSound(sndCardDeal);
        UnloadSound(sndCardFlip);
        UnloadSound(sndChip);
        UnloadSound(sndWin);
        UnloadSound(sndMegaWin);
        UnloadSound(sndLose);
        UnloadSound(sndClick);
        UnloadSound(sndBassKick);
        UnloadSound(sndRouletteTick);
        CloseAudioDevice();
    }
};

