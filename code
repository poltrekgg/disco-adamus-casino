        float txtY = y - (numChips * 5.0f) - 34.0f;
        fonts.DrawCentered(label, x, txtY, 21.0f, WHITE);
        fonts.DrawCentered(TextFormat("$%d", amount), x, txtY + 23.0f, 24.0f, COL_GOLD);
    }

