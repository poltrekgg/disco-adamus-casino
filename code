void DrawRoundedBoxWithBorder(Rectangle r, float roundness, float borderThick, Color fillCol, Color borderCol) {
    Rectangle outer = { r.x - borderThick, r.y - borderThick, r.width + borderThick * 2.0f, r.height + borderThick * 2.0f };
    DrawRectangleRounded(outer, roundness, 10, borderCol);
    DrawRectangleRounded(r, roundness, 10, fillCol);
}

enum Suit { HEARTS = 0, DIAMONDS = 1, CLUBS = 2, SPADES = 3 };

void DrawSuitIcon(Suit suit, float cx, float cy, float size, float scaleX, Color col) {
    float sx = size * scaleX;
    float sy = size;
    if (sx < 0.5f) return;

    if (suit == DIAMONDS) {
        Vector2 top = { cx, cy - sy };
        Vector2 right = { cx + sx * 0.78f, cy };
        Vector2 bot = { cx, cy + sy };
        Vector2 left = { cx - sx * 0.78f, cy };
        DrawTriangle(top, left, right, col);
        DrawTriangle(bot, right, left, col);
    } else if (suit == HEARTS) {
        float r = sy * 0.46f;
        DrawCircleV({ cx - sx * 0.36f, cy - sy * 0.25f }, r * scaleX, col);
        DrawCircleV({ cx + sx * 0.36f, cy - sy * 0.25f }, r * scaleX, col);
        Vector2 p1 = { cx - sx * 0.78f, cy - sy * 0.1f };
        Vector2 p2 = { cx + sx * 0.78f, cy - sy * 0.1f };
        Vector2 p3 = { cx, cy + sy * 0.92f };
        DrawTriangle(p1, p3, p2, col);
    } else if (suit == SPADES) {
        Vector2 top = { cx, cy - sy * 0.95f };
        Vector2 left = { cx - sx * 0.78f, cy + sy * 0.05f };
        Vector2 right = { cx + sx * 0.78f, cy + sy * 0.05f };
        DrawTriangle(top, left, right, col);
        float r = sy * 0.42f;
        DrawCircleV({ cx - sx * 0.34f, cy + sy * 0.15f }, r * scaleX, col);
        DrawCircleV({ cx + sx * 0.34f, cy + sy * 0.15f }, r * scaleX, col);
        Vector2 s1 = { cx, cy + sy * 0.2f };
        Vector2 s2 = { cx - sx * 0.32f, cy + sy * 0.92f };
        Vector2 s3 = { cx + sx * 0.32f, cy + sy * 0.92f };
        DrawTriangle(s1, s2, s3, col);
    } else if (suit == CLUBS) {
        float r = sy * 0.40f;
        DrawCircleV({ cx, cy - sy * 0.38f }, r * scaleX, col);
        DrawCircleV({ cx - sx * 0.40f, cy + sy * 0.12f }, r * scaleX, col);
        DrawCircleV({ cx + sx * 0.40f, cy + sy * 0.12f }, r * scaleX, col);
        Vector2 s1 = { cx, cy + sy * 0.1f };
        Vector2 s2 = { cx - sx * 0.32f, cy + sy * 0.92f };
        Vector2 s3 = { cx + sx * 0.32f, cy + sy * 0.92f };
        DrawTriangle(s1, s2, s3, col);
    }
}

