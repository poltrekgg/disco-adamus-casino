        fonts.DrawCentered(TextFormat("DOSTĘPNY HAJS: $%d     |     REKORD: $%d", balance, highScore), 640.0f, 82.0f, 26.0f, COL_GREEN);

        struct ShopEntry {
            const char* category;
            const char* name;
            const char* desc;
            int price;
        };

        ShopEntry tables[3] = {
            { "MOTYW STOŁU", "Disco Classic",     "Klasyczny fiolet i neonowy cyjan", 0 },
            { "MOTYW STOŁU", "Cyber Purple Neon", "Głęboki fiolet z elektryczną aurą", 500 },
            { "MOTYW STOŁU", "High-Roller Gold",  "Szmaragdowe sukno i szczere złoto", 1500 }
        };
        ShopEntry backs[3] = {
            { "REWERS KART", "Disco Ball VIP",    "Holograficzna kula dyskotekowa",    0 },
            { "REWERS KART", "Golden Cyber Grid", "Czarno-złoty diament dla szefów",   400 },
            { "REWERS KART", "Crimson Matrix",    "Karmazynowy synthwave z neonem",    1200 }
        };
        ShopEntry shades[3] = {
            { "OKULARY ADAMUSA", "Disco Visor",       "Klasyczny różowo-cyjanowy wizjer", 0 },
            { "OKULARY ADAMUSA", "Thug Life Pixels",  "Czarne pikselowe okulary 8-bit",   600 },
            { "OKULARY ADAMUSA", "Golden Aviators",   "Złote awiatory prezesa kasyna",    2000 }
        };

        const char* colHeaders[3] = { "1. MOTYWY STOŁU", "2. REWERSY KART", "3. OKULARY ADAMUSA" };
        for (int c = 0; c < 3; c++) {
            float colX = 70.0f + c * 390.0f;
            fonts.DrawCentered(colHeaders[c], colX + 180.0f, 130.0f, 25.0f, COL_CYAN);

            for (int r = 0; r < 3; r++) {
                Rectangle cardBox = { colX, 160.0f + r * 175.0f, 360.0f, 155.0f };
                ShopEntry item = (c == 0) ? tables[r] : ((c == 1) ? backs[r] : shades[r]);
                bool unlocked = (c == 0) ? unlockedTables[r] : ((c == 1) ? unlockedBacks[r] : unlockedShades[r]);
                bool equipped = (c == 0) ? (activeTable == r) : ((c == 1) ? (activeBack == r) : (activeShades == r));

                Color border = equipped ? COL_GREEN : (unlocked ? COL_CYAN : COL_PINK);
                DrawRoundedBoxWithBorder(cardBox, 0.15f, equipped ? 3.0f : 2.0f, { 26, 0, 48, 240 }, border);

                fonts.DrawCentered(item.name, colX + 180.0f, cardBox.y + 30.0f, 25.0f, COL_GOLD);
                fonts.DrawCentered(item.desc, colX + 180.0f, cardBox.y + 62.0f, 17.0f, WHITE);

                Button actionBtn;
                actionBtn.rect = { colX + 60.0f, cardBox.y + 94.0f, 240.0f, 44.0f };
                if (equipped) {
                    actionBtn.text = "ZAŁOŻONO [AKTYWNE]";
                    actionBtn.baseColor = COL_GREEN;
                } else if (unlocked) {
                    actionBtn.text = "ZAŁÓŻ";
                    actionBtn.baseColor = COL_BLUE;
                } else {
                    actionBtn.text = TextFormat("KUP ZA $%d", item.price);
                    actionBtn.baseColor = (balance >= item.price) ? COL_PINK : COL_GREY;
                    actionBtn.active = (balance >= item.price);
                }

                actionBtn.Draw(fonts, mouse);
                if (actionBtn.IsClicked(mouse)) {
                    if (unlocked) {
                        if (c == 0) activeTable = r;
                        else if (c == 1) activeBack = r;
                        else activeShades = r;
                        PlaySound(audio.sndClick);
                        SaveGame();
                    } else if (balance >= item.price) {
                        balance -= item.price;
                        if (c == 0) { unlockedTables[r] = true; activeTable = r; }
                        else if (c == 1) { unlockedBacks[r] = true; activeBack = r; }
                        else { unlockedShades[r] = true; activeShades = r; }
                        PlaySound(audio.sndWin);
                        SaveGame();
                    }
                }
            }
        }

        // Podgląd na żywo na dole ekranu Sklepu
        fonts.DrawCentered("PODGLĄD WYPOSAŻENIA NA ŻYWO (UŻYJ ESC LUB PRZYCISKU MENU ABY WRÓCIĆ)", 640.0f, 755.0f, 21.0f, COL_GOLD);
