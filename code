                Rectangle r = {
                    startX + col * cellW,
                    startY + row * cellH,
                    cellW - 4.0f,
                    cellH - 4.0f
                };
                rouletteSpots.push_back({ r, RBET_STRAIGHT, num, TextFormat("%d", num), c, 0 });
            }
        }

        // 3 Kolumny (2 TO 1) po prawej stronie siatki
        for (int row = 0; row < 3; row++) {
            Rectangle r = {
                startX + 12.0f * cellW,
                startY + row * cellH,
                62.0f,
                cellH - 4.0f
            };
            rouletteSpots.push_back({ r, RBET_COLUMN, row, "2:1", { 42, 0, 74, 255 }, 0 });
        }

        // 3 Tuziny (1st 12, 2nd 12, 3rd 12)
        float dozY = startY + 3.0f * cellH + 6.0f;
        const char* dozLabels[3] = { "1st 12 (1-12)", "2nd 12 (13-24)", "3rd 12 (25-36)" };
        for (int d = 0; d < 3; d++) {
            Rectangle r = {
                startX + d * (4.0f * cellW),
                dozY,
                4.0f * cellW - 4.0f,
                52.0f
            };
            rouletteSpots.push_back({ r, RBET_DOZEN, d, dozLabels[d], { 36, 0, 68, 255 }, 0 });
        }

        // 6 Szans Prostych (1:1)
        float evenY = dozY + 58.0f;
        float evenW = 2.0f * cellW;
        struct EvenDef { RouletteBetType t; const char* lbl; Color col; };
        EvenDef evens[6] = {
            { RBET_LOW,   "1-18",       { 30, 0, 56, 255 } },
            { RBET_EVEN,  "PARZYSTE",   { 30, 0, 56, 255 } },
