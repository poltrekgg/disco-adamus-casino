// KLASA KARTY (ANIMACJA LOTU, OBRÓT 3D, 3 STYLE REWERSÓW ZE SKLEPU VIP)
// ============================================================================
struct Card {
    Suit suit;
    std::string rank;
    int value;

    float x, y;
    float targetX, targetY;
    float delayTimer = 0.0f;
    bool soundPlayed = false;

    float flipProgress = 1.0f;
    float targetFlip = 1.0f;

    Card(Suit s, const std::string& r, int v, bool startHidden = false, float delay = 0.0f)
        : suit(s), rank(r), value(v), delayTimer(delay) {
        x = SHOE_X;
        y = SHOE_Y;
        targetX = SHOE_X;
        targetY = SHOE_Y;
        flipProgress = startHidden ? 0.0f : 1.0f;
        targetFlip = flipProgress;
    }

    bool IsSettled() const {
        return delayTimer <= 0.0f &&
               std::fabs(x - targetX) < 3.0f &&
               std::fabs(y - targetY) < 3.0f &&
               std::fabs(flipProgress - targetFlip) < 0.05f;
    }

    void Update(float dt, ProceduralAudio& audio) {
        if (delayTimer > 0.0f) {
            delayTimer -= dt;
            return;
        }
        if (!soundPlayed) {
            PlaySound(audio.sndCardDeal);
            soundPlayed = true;
        }

        float speed = 11.5f;
        x += (targetX - x) * std::min(1.0f, speed * dt);
        y += (targetY - y) * std::min(1.0f, speed * dt);

        if (std::fabs(flipProgress - targetFlip) > 0.005f) {
            float dir = (targetFlip > flipProgress) ? 1.0f : -1.0f;
            flipProgress = std::clamp(flipProgress + dir * dt * 4.2f, 0.0f, 1.0f);
        }
    }

    void Draw(const FontSystem& fonts, float globalTime, int backStyle = 0) const {
        if (delayTimer > 0.0f) return;

        float angle = flipProgress * PI;
        float scaleX = std::fabs(cosf(angle));
        bool showBack = (flipProgress < 0.5f);

        float dist = hypotf(targetX - x, targetY - y);
        float lift = std::clamp(dist * 0.06f, 0.0f, 18.0f);

        float w = std::max(4.0f, CARD_W * scaleX);
        float drawX = x + (CARD_W - w) * 0.5f;
        float drawY = y - lift * 0.35f;

        Rectangle shadowRect = { drawX + 6.0f + lift * 0.5f, y + 7.0f + lift * 0.4f, w, CARD_H };
        DrawRectangleRounded(shadowRect, 0.12f, 8, { 0, 0, 0, 150 });

        Rectangle cardRect = { drawX, drawY, w, CARD_H };

        if (showBack) {
            if (backStyle == 1) {
                // STYL 1: GOLDEN CYBER GRID VIP
                DrawRoundedBoxWithBorder(cardRect, 0.12f, 2.5f, { 18, 14, 4, 255 }, COL_GOLD);
                if (scaleX > 0.2f) {
                    Rectangle inner = { drawX + 6.0f * scaleX, drawY + 6.0f, w - 12.0f * scaleX, CARD_H - 12.0f };
                    DrawRoundedBoxWithBorder(inner, 0.10f, 1.5f, { 34, 26, 8, 255 }, COL_ORANGE);
                    float cx = drawX + w * 0.5f;
                    float cy = drawY + CARD_H * 0.5f;
                    DrawSuitIcon(DIAMONDS, cx, cy, 34.0f, scaleX, COL_GOLD);
                    DrawSuitIcon(DIAMONDS, cx, cy, 20.0f, scaleX, { 25, 20, 5, 255 });
                    if (scaleX > 0.55f) {
                        fonts.DrawCentered("GOLD VIP", cx, drawY + 22.0f, 16.0f * scaleX, COL_GOLD, false);
                        fonts.DrawCentered("ADAMUS", cx, drawY + CARD_H - 22.0f, 16.0f * scaleX, COL_GOLD, false);
                    }
                }
            } else if (backStyle == 2) {
                // STYL 2: CRIMSON MATRIX SYNTHWAVE
                DrawRoundedBoxWithBorder(cardRect, 0.12f, 2.5f, { 28, 0, 14, 255 }, COL_PINK);
                if (scaleX > 0.2f) {
                    Rectangle inner = { drawX + 6.0f * scaleX, drawY + 6.0f, w - 12.0f * scaleX, CARD_H - 12.0f };
                    DrawRoundedBoxWithBorder(inner, 0.10f, 1.5f, { 48, 0, 24, 255 }, COL_CYAN);
                    float cx = drawX + w * 0.5f;
                    float cy = drawY + CARD_H * 0.45f;
                    DrawCircleV({ cx, cy }, 25.0f * scaleX, COL_PINK);
                    DrawCircleV({ cx, cy }, 18.0f * scaleX, COL_GOLD);
                    for (int l = -2; l <= 2; l++) {
                        DrawLineEx({ cx - 26.0f * scaleX, cy + l * 8.0f }, { cx + 26.0f * scaleX, cy + l * 8.0f }, 2.0f, { 48, 0, 24, 255 });
                    }
                    if (scaleX > 0.55f) {
                        fonts.DrawCentered("AURA", cx, drawY + 20.0f, 16.0f * scaleX, COL_CYAN, false);
                        fonts.DrawCentered("ULTRA", cx, drawY + CARD_H - 22.0f, 17.0f * scaleX, COL_PINK, false);
                    }
                }
            } else {
                // STYL 0: DOMYŚLNY REWERS DISCO ADAMUS VIP
                DrawRoundedBoxWithBorder(cardRect, 0.12f, 2.5f, { 22, 0, 44, 255 }, COL_CYAN);
                if (scaleX > 0.2f) {
                    Rectangle inner = { drawX + 6.0f * scaleX, drawY + 6.0f, w - 12.0f * scaleX, CARD_H - 12.0f };
                    DrawRoundedBoxWithBorder(inner, 0.10f, 1.5f, { 36, 0, 68, 255 }, COL_PINK);

                    float cx = drawX + w * 0.5f;
                    float cy = drawY + CARD_H * 0.46f;
                    float ballR = 26.0f;

                    DrawCircleV({ cx, cy }, ballR * scaleX, { 0, 255, 234, 60 });
                    DrawCircleV({ cx, cy }, (ballR - 4.0f) * scaleX, COL_GOLD);

                    for (int row = -2; row <= 2; row++) {
                        for (int col = -2; col <= 2; col++) {
                            if (row * row + col * col <= 5) {
                                Color tileCol = ((row + col + (int)(globalTime * 8.0f)) % 2 == 0) ? COL_CYAN : COL_PINK;
                                DrawRectanglePro(
                                    { cx + col * 6.5f * scaleX, cy + row * 6.5f, 4.5f * scaleX, 4.5f },
                                    { 2.2f * scaleX, 2.2f }, 0.0f, tileCol
                                );
                            }
                        }
                    }

                    if (scaleX > 0.55f) {
                        fonts.DrawCentered("DISCO", cx, drawY + 20.0f, 16.0f * scaleX, COL_CYAN, false);
                        fonts.DrawCentered("ADAMUS", cx, cy + 38.0f, 17.0f * scaleX, COL_GOLD, false);
                        fonts.DrawCentered("VIP", cx, cy + 56.0f, 15.0f * scaleX, COL_PINK, false);
                    }
                }
            }
        } else {
            bool isRed = (suit == HEARTS || suit == DIAMONDS);
            Color suitCol = isRed ? COL_PINK : Color{ 20, 25, 45, 255 };
            Color borderCol = (rank == "A" || rank == "K" || rank == "Q" || rank == "J") ? COL_GOLD : COL_CYAN;

            DrawRoundedBoxWithBorder(cardRect, 0.12f, 2.5f, { 248, 248, 255, 255 }, borderCol);

            if (scaleX > 0.25f) {
                float cx = drawX + w * 0.5f;
                float cy = drawY + CARD_H * 0.5f;

                fonts.DrawCentered(rank, drawX + 16.0f * scaleX, drawY + 18.0f, 22.0f * scaleX, suitCol, false);
