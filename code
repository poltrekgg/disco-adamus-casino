    audio.Init();

    DiscoAdamusCasino game;

    while (!WindowShouldClose() && !game.shouldExitGame) {
        float dt = std::min(GetFrameTime(), 0.05f);
        float time = (float)GetTime();
        Vector2 mouse = GetMousePosition();

        if (game.currentScreen == SCREEN_MENU) {
            game.HandleMenuInput(mouse, audio);
        } else if (game.currentScreen == SCREEN_BLACKJACK) {
            game.HandleBlackjackInput(mouse, audio);
        } else if (game.currentScreen == SCREEN_ROULETTE) {
            game.HandleRouletteInput(mouse, audio);
        }

        game.Update(dt, audio);

        BeginDrawing();
        game.Draw(fonts, time, audio);
        EndDrawing();
    }

    game.SaveGame();
    audio.Unload();
    fonts.Unload();
    CloseWindow();
    return 0;
}
