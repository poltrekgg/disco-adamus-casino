    bool CheckRouletteSpotWin(const RouletteBetSpot& s, int winNum) const {
        switch (s.type) {
            case RBET_STRAIGHT: return (winNum == s.param);
            case RBET_DOZEN:
                if (winNum <= 0) return false;
                return ((winNum - 1) / 12 == s.param);
            case RBET_COLUMN:
                if (winNum <= 0) return false;
                if (s.param == 0) return (winNum % 3 == 0);
                if (s.param == 1) return (winNum % 3 == 2);
                return (winNum % 3 == 1);
            case RBET_LOW:   return (winNum >= 1 && winNum <= 18);
            case RBET_HIGH:  return (winNum >= 19 && winNum <= 36);
            case RBET_EVEN:  return (winNum > 0 && (winNum % 2 == 0));
            case RBET_ODD:   return (winNum > 0 && (winNum % 2 == 1));
            case RBET_RED:   return IsRedNumber(winNum);
            case RBET_BLACK: return (winNum > 0 && !IsRedNumber(winNum));
        }
        return false;
    }

    int GetRouletteMultiplier(RouletteBetType type) const {
        if (type == RBET_STRAIGHT) return 36; // 35:1 + zwrot stawki
        if (type == RBET_DOZEN || type == RBET_COLUMN) return 3; // 2:1 + zwrot stawki
        return 2; // 1:1 + zwrot stawki
    }

