struct Button {
    Rectangle rect;
    std::string text;
    Color baseColor;
    bool active = true;
    float hoverScale = 0.0f;

    void Draw(const FontSystem& fonts, Vector2 mousePos) {
        bool hovered = active && CheckCollisionPointRec(mousePos, rect);
        hoverScale += ((hovered ? 1.0f : 0.0f) - hoverScale) * 0.2f;

        float lift = hoverScale * 3.0f;
        Rectangle r = { rect.x, rect.y - lift, rect.width, rect.height };

        Color fill = active ? baseColor : COL_GREY;
        Color border = active ? (hovered ? WHITE : Color{ 255, 255, 255, 140 }) : Color{ 100, 100, 110, 100 };

        DrawRectangleRounded({ r.x + 2, r.y + 4, r.width, r.height }, 0.25f, 8, { 0, 0, 0, 160 });
        DrawRoundedBoxWithBorder(r, 0.25f, 2.0f, fill, border);

        bool darkText = (text == "ROZDAJ" || text == "ZAKRĘĆ!" || baseColor.r + baseColor.g > 450);
        Color txtCol = active ? (darkText ? BLACK : WHITE) : Color{ 150, 150, 160, 255 };
        float fSize = (r.height >= 54.0f) ? 26.0f : ((text == "ROZDAJ" || text == "ZAKRĘĆ!") ? 22.0f : 18.0f);
        fonts.DrawCentered(text, r.x + r.width * 0.5f, r.y + r.height * 0.5f, fSize, txtCol, !darkText);
    }

    bool IsClicked(Vector2 mousePos) const {
        return active && CheckCollisionPointRec(mousePos, rect) && IsMouseButtonPressed(MOUSE_BUTTON_LEFT);
    }
};

struct Particle {
    bool isCoin;
    float x, y;
    float dx, dy;
    float radius;
    float spinPhase;
    float spinSpeed;

    Particle(bool coin, float startX, float startY) : isCoin(coin), x(startX), y(startY) {
        if (coin) {
            dx = (float)GetRandomValue(-550, 550);
            dy = (float)GetRandomValue(-850, -150);
            radius = (float)GetRandomValue(14, 28);
            spinPhase = (float)GetRandomValue(0, 628) / 100.0f;
            spinSpeed = (float)GetRandomValue(6, 15);
        } else {
            dx = (float)GetRandomValue(-380, 380);
            dy = (float)GetRandomValue(-380, 380);
            radius = 1.0f;
            spinPhase = (float)GetRandomValue(0, 628) / 100.0f;
            spinSpeed = 10.0f;
        }
    }

    void Update(float dt) {
        x += dx * dt;
        y += dy * dt;
        spinPhase += spinSpeed * dt;

        if (isCoin) {
            dy += 1450.0f * dt;
            if (y > SCREEN_H - radius) {
                y = SCREEN_H - radius;
                dy = -std::fabs(dy) * 0.78f;
            }
            if (x < radius || x > SCREEN_W - radius) dx *= -0.9f;
        } else {
            if (x < 40 || x > SCREEN_W - 40) dx *= -1.0f;
            if (y < 40 || y > SCREEN_H - 40) dy *= -1.0f;
        }
    }

    void Draw() const {
        if (isCoin) {
            float sx = std::max(0.2f, std::fabs(cosf(spinPhase)));
            DrawEllipse((int)x, (int)y, radius * sx + 2.5f, radius + 2.5f, COL_PINK);
            DrawEllipse((int)x, (int)y, radius * sx, radius, COL_GOLD);
            if (sx > 0.45f) {
                DrawEllipse((int)x, (int)y, radius * 0.55f * sx, radius * 0.55f, { 255, 245, 150, 255 });
            }
        } else {
            float s = 0.48f;
            float wave = sinf(spinPhase) * 12.0f * s;
            DrawCircleLines((int)x, (int)(y - 30 * s), 11 * s, COL_CYAN);
            DrawLineEx({ x, y - 19 * s }, { x, y + 22 * s }, 3.0f, COL_PINK);
            DrawLineEx({ x - 26 * s, y - 8 * s + wave }, { x + 26 * s, y - 8 * s - wave }, 3.0f, COL_GREEN);
            DrawLineEx({ x, y + 22 * s }, { x - 20 * s, y + 52 * s }, 3.0f, COL_CYAN);
            DrawLineEx({ x, y + 22 * s }, { x + 20 * s, y + 52 * s }, 3.0f, COL_CYAN);
        }
    }
};

