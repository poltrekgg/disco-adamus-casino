    void DrawChipStack(const FontSystem& fonts, float x, float y, int amount, const std::string& label) const {
        if (amount <= 0 && label != "ZAKŁAD") return;
        int numChips = std::min(amount / 25, 18);
        if (numChips <= 0 && amount > 0) numChips = 1;

        for (int i = 0; i < numChips; i++) {
            float cy = y - (i * 5.0f);
            Color chipEdge = (i % 3 == 0) ? COL_CYAN : ((i % 3 == 1) ? COL_PINK : COL_GOLD);
            DrawEllipse((int)x, (int)cy + 3, 29, 17, { 0, 0, 0, 140 });
            DrawEllipse((int)x, (int)cy, 28, 16, { 20, 20, 28, 255 });
            DrawEllipse((int)x, (int)cy, 26, 14, chipEdge);
            DrawEllipse((int)x, (int)cy, 21, 11, { 26, 0, 45, 255 });
            DrawEllipse((int)x, (int)cy, 13, 7, COL_PINK);
