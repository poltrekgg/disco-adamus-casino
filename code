    void HandleBlackjackInput(Vector2 mouse, ProceduralAudio& audio) {
        if (btnBackMenu.IsClicked(mouse)) {
            PlaySound(audio.sndClick);
            isMegaWin = false;
            SaveGame();
            currentScreen = SCREEN_MENU;
            return;
        }

        if (state == "BETTING") {
            if (btnMin50.IsClicked(mouse)) {
                currentBet = std::max(10, currentBet - 50);
                PlaySound(audio.sndChip);
            } else if (btnMinus.IsClicked(mouse)) {
                currentBet = std::max(10, currentBet - 10);
                PlaySound(audio.sndChip);
            } else if (btnPlus.IsClicked(mouse)) {
                currentBet = std::min(balance, currentBet + 10);
                PlaySound(audio.sndChip);
            } else if (btnPlus50.IsClicked(mouse)) {
                currentBet = std::min(balance, currentBet + 50);
                PlaySound(audio.sndChip);
            } else if (btnDeal.IsClicked(mouse) || IsKeyPressed(KEY_SPACE)) {
                PlaySound(audio.sndClick);
                StartGame();
            }
        } else if (state == "PLAYING") {
            if (btnHit.IsClicked(mouse) || IsKeyPressed(KEY_H)) {
                PlaySound(audio.sndClick);
                Hit(audio);
            } else if (btnStand.IsClicked(mouse) || IsKeyPressed(KEY_S)) {
                PlaySound(audio.sndClick);
                hands[currentHandIdx].status = "STOOD";
                NextHandOrDealer(audio);
            } else if (btnDouble.active && (btnDouble.IsClicked(mouse) || IsKeyPressed(KEY_D))) {
                DoubleDown(audio);
            } else if (btnSplit.active && (btnSplit.IsClicked(mouse) || IsKeyPressed(KEY_P))) {
                SplitHand(audio);
            }
        }
    }

